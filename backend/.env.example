# 复制为 .env 后按需修改。这个文件本身会进 git，.env 不进。
APP_NAME=小学学习工作台
ENV=dev

# 换成随机串：python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# 应用账号，不是 root：init_db.sh 建出来的 study 只对 study_table 有权限。
# 密码留空占位，真正的值由 init_db.sh 随机生成后写进 .env（.env 不进 git）
MYSQL_USER=study
MYSQL_PASSWORD=change-me
MYSQL_DB=study_table

# 运行时数据根目录，刻意放在仓库之外
DATA_ROOT=~/study_table_data
MAX_UPLOAD_MB=60

TIMEZONE=Asia/Shanghai
# 定时任务开关：开发时用 --reload 建议关掉，避免热重载重复触发
SCHEDULER_ENABLED=true
